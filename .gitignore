# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
# Python build
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Secrets & Environment Variables (NEVER COMMIT)
.env
.env.local
.env.*.local
backend/.env

# Node & Frontend dependencies
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Allow compiled frontend distribution for zero-config production deployment
!frontend/dist
!frontend/dist/**

# Databases & local user files
*.db-journal
*.sqlite3-journal

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor caches
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Temporary uploads / storage (keep directory structure via .gitkeep)
storage/uploads/*
!storage/uploads/.gitkeep
storage/generated/*
!storage/generated/.gitkeep
