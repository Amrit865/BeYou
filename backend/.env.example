# BeYou – AI-Powered Women's Fashion Designer & Image Analysis System
# Backend Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# OpenAI API Key (Required for Image Generation and Vision Image Analysis)
# Obtain your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Supported Models
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_VISION_MODEL=gpt-4o

# Database
DATABASE_URL=sqlite:///./beyou.db
